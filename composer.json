{
    "name": "daryl-peterson/librenms-device-path",
    "description": "LibreNMS Plugin for showing device path under the device view",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "daryl-peterson",
            "email": "daryl.peterson@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.5",
        "librenms/plugin-interfaces": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DRP\\DevicePaths\\": "src/"
        },
        "files": [
            "src/constants.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "DRP\\DevicePaths\\PluginProvider"
            ]
        }
    }
}
